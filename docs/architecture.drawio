        <mxCell id="e1" value="HTTPS · SSE（开发期 Vite 代理 /api → :8100）" style="edgeStyle=none;html=1;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.4" edge="1" parent="1" source="pane" target="backend">
