# ============================================================
# Word AI Copilot 后端配置示例
# 复制为 backend/.env 后填写实际值
# ============================================================

# ---- LLM（OpenAI 兼容接口）----
# provider 第一版统一走 OpenAI Compatible 协议（OpenAI / DeepSeek / Qwen / 智谱 / 企业模型）
LLM_PROVIDER=openai

# 基础地址（注意包含版本路径，例如 OpenAI 官方为 https://api.openai.com/v1）
LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=sk-xxxx

LLM_MODEL=gpt-4o-mini

# ---- 可选调优 ----
# 对话流式超时（秒）
LLM_TIMEOUT_SECONDS=120
# Edit 生成超时（秒）
LLM_EDIT_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ---- Agent（批量编辑 / 文档问答，Microsoft Agent Framework）----
# 未安装 agent-framework 时后端仍可启动，agent 接口返回 AGENT_NOT_INSTALLED
# py -m pip install agent-framework-core agent-framework-openai
# 单次任务最大提案数
AGENT_MAX_PROPOSALS=20
# Agent 运行总超时（秒）
AGENT_TIMEOUT_SECONDS=300
# 单次任务最大工具调用次数
AGENT_MAX_TOOL_CALLS=40

# ---- CORS ----
# 开发环境默认放行本地任务窗格；生产环境必须改为 Add-in 实际 Origin（逗号分隔，禁止 *）
BACKEND_CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# ---- 本地日志 ----
# 默认写入 backend/logs/（该目录已加入 .gitignore）
LOG_DIR=logs
LOG_LEVEL=INFO
# 单个日志文件 10 MB，保留 5 个备份
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# 结构化记录每次 chat / agent / edit 调用
CONVERSATION_LOG_ENABLED=true
# true 会记录对话及文档内容；false 只记录字段长度和调用元数据
CONVERSATION_LOG_INCLUDE_CONTENT=true
# 单个文本字段最大保留字符数
CONVERSATION_LOG_MAX_TEXT_CHARS=20000
